! =============================================================================
! ice_in template for model_type ufs_schism_cice (CICE6 in UFS-Coastal).
! Rendered per group by gen_ice_in into I{ID}_{group}/ice_in: the placeholder
! values come from the group dates, ufs_schism_cice.yaml (ice_* keys) and the
! CICE grid in fix/cice/ (gen_cice_grid).
! Physics and output choices are those of the working UFS-Coastal Bering Sea
! runs of Scott Durski on Hercules (Run_Dir_DATM_SCH_CICE, Nov 2026):
! 5 categories, 7 ice layers, mushy thermodynamics, EVP, seabed stress,
! form drag, prognostic salt flux, coupled sea-surface tilt.
! Under NUOPC the run type (initial/continue) follows start_type of
! ufs.configure; restarts are written at the end of the group (restart_n)
! to ./RESTART/iced.<date>.nc and listed in ./ice.restart_file.
! =============================================================================
&setup_nml
    days_per_year       = 365
    use_leap_years      = .true.
    year_init           = @[YEAR_INIT]
    month_init          = @[MONTH_INIT]
    day_init            = @[DAY_INIT]
    sec_init            = @[SEC_INIT]
    dt                  = @[ICE_DT]
    npt                 = 999999
    ndtd                = 4
    runtype             = '@[RUNTYPE]'
    runid               = 'unknown'
    ice_ic              = '@[ICE_IC]'
    restart             = @[RESTART]
    restart_ext         = .true.
    use_restart_time    = @[USE_RESTART_TIME]
    numin               = 21
    numax               = 89
    restart_format      = 'cdf1'
    restart_iotasks     = -99
    restart_rearranger  = 'box'
    restart_root        = -99
    restart_stride      = -99
    restart_chunksize   = 0,0
    restart_deflate     = 0
    restart_dir         = './RESTART/'
    restart_file        = 'iced'
    pointer_file        = './ice.restart_file'
    dumpfreq            = 'd'
    dumpfreq_n          =  9999
    dump_last           = .false.
    bfbflag             = 'off'
    diagfreq            =  12
    diag_type           = 'file'
    diag_file           = 'ice_diag.d'
    print_global        = .true.
    print_points        = .false.
    history_format      = 'cdf1'
    history_iotasks     = -99
    history_rearranger  = 'box'
    history_root        = -99
    history_stride      = -99
    history_chunksize   = 0,0
    history_deflate     = 0
    history_precision   = 4
    histfreq            = '@[HISTFREQ]','x','x','x','x'
    histfreq_n          =  @[HISTFREQ_N] , 1 , 1 , 1 , 1
    hist_avg            = .true.
    history_dir         = './history/'
    history_file        = 'iceh'
    write_ic            = .false.
    incond_dir          = './RESTART/'
    incond_file         = 'none'
    version_name        = 'CICE_6.0.2'
/

&grid_nml
    grid_format       = 'nc'
    grid_type         = 'regional'
    grid_file         = './cice_grid/grid_cice.nc'
    kmt_file          = './cice_grid/kmt_cice.nc'
    bathymetry_file   = './cice_grid/bathy_cice.nc'
    bathymetry_format = 'default'
    use_bathymetry    = .true.
    kcatbound    = 0
    ncat         = 5
    nfsd         = 1
    nilyr        = 7
    nslyr        = 1
    nblyr        = 1
    grid_atm     = 'A'
    grid_ocn     = 'A'
    grid_ice     = 'B'
/

